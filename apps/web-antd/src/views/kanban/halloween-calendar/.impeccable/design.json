      "css": ".ds-switch{display:flex;gap:4px;}.ds-switch button{font:14px/1.6 'Segoe UI','Microsoft YaHei',sans-serif;font-variant-numeric:tabular-nums;border:1px solid #ded8cc;border-radius:7px;min-height:36px;padding:6px 12px;cursor:pointer;transition:background 0.16s;font-size:12px;min-height:32px;padding:4px 10px;background:#fffdf8;color:#173b39;}.ds-switch button:hover{background:#eee9df;}.ds-switch button:active{background:#e2e8df;}.ds-switch button[aria-pressed='true']{background:#173b39;color:#fffdf8;border-color:#173b39;}.ds-switch button:focus-visible{outline:3px solid #ab522d;outline-offset:3px;}"
    },
    {
      "name": "状态徽标",
      "kind": "chip",
      "refersTo": "badge",
      "description": "颜色与文字并用，表达提醒、正常和资料状态。",
      "html": "<span class=\"ds-badge\">库存提醒</span> <span class=\"ds-badge ds-badge-green\">正常跟进</span> <span class=\"ds-badge ds-badge-gray\">资料待核对</span>",
      "css": ".ds-badge{font:14px/1.6 'Segoe UI','Microsoft YaHei',sans-serif;font-variant-numeric:tabular-nums;display:inline-block;padding:2px 7px;background:#fff0df;color:#913c24;font-size:11px;border-radius:4px;white-space:nowrap;}.ds-badge-green{background:#eaf0e8;color:#315a43;}.ds-badge-gray{background:#eeeae1;color:#586e65;}"
    },
    {
      "name": "摘要单元",
      "kind": "card",
      "refersTo": "metric",
      "description": "五项摘要中的单元；数字是示例排版，不是实时指标。",
      "html": "<div class=\"ds-metric\"><span>目标完成率</span><strong>40.0%</strong></div>",
      "css": ".ds-metric{font:14px/1.6 'Segoe UI','Microsoft YaHei',sans-serif;font-variant-numeric:tabular-nums;background:#f8f6f0;padding:12px 14px;color:#173b39;}.ds-metric span{font-size:12px;color:#586e65;display:block;}.ds-metric strong{font-size:22px;display:block;margin-top:4px;}@media(max-width:600px){.ds-metric{padding:10px;}.ds-metric span{font-size:11px;}.ds-metric strong{font-size:20px;}}"
    },
    {
      "name": "可下钻分组",
      "kind": "card",
      "refersTo": "group",
      "description": "英文分类与目标进度相邻；展示值仅用于组件排版预览。",
      "html": "<button class=\"ds-group\" aria-label=\"查看 bodystocking 商品\"><div class=\"ds-group-title\"><strong>bodystocking</strong><span>40.0%</span></div><div class=\"ds-group-track\"><i style=\"width:40%\"></i></div><div class=\"ds-group-values\"><span>已完成 <b>400</b> / 1,000</span><span>还差 <b>600</b> 件</span></div></button>",
      "css": ".ds-group{font:14px/1.6 'Segoe UI','Microsoft YaHei',sans-serif;font-variant-numeric:tabular-nums;padding:12px 14px;border:0;background:#f0f3f0;border-radius:8px;text-align:left;color:#173b39;cursor:pointer;transition:background 0.16s;min-width:280px;}.ds-group:hover{background:#e6ece6;}.ds-group:focus-visible{outline:3px solid #ab522d;outline-offset:3px;}.ds-group-title{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:7px;}.ds-group-title strong{font-size:14px;overflow-wrap:anywhere;}.ds-group-title span{font-size:12px;color:#586e65;}.ds-group-track{height:4px;background:#e3e9df;border-radius:3px;overflow:hidden;}.ds-group-track i{display:block;height:100%;max-width:100%;background:#507768;border-radius:3px;}.ds-group-values{display:flex;justify-content:space-between;gap:12px;font-size:12px;margin-top:7px;color:#586e65;}.ds-group-values b{color:#173b39;font-weight:600;}"
    },
    {
      "name": "当前日历阶段",
      "kind": "custom",
      "description": "取七阶段中当前阶段的样式片段；时间经过不代表任务完成。",
      "html": "<div class=\"ds-stage-preview\"><ol class=\"ds-stages\"><li aria-current=\"step\"><b>3</b><span>检查与预估</span><small>9/16—9/30</small></li></ol><p class=\"ds-stage-note\">6/15 天 · 仅表示时间经过，不代表任务完成</p></div>",
      "css": ".ds-stage-preview{font:14px/1.6 'Segoe UI','Microsoft YaHei',sans-serif;font-variant-numeric:tabular-nums;background:#fffdf8;padding:16px;color:#173b39;}.ds-stages{list-style:none;margin:0;padding:0;}.ds-stages li{font-size:12px;font-weight:600;}.ds-stages b{display:block;width:23px;height:23px;text-align:center;border-radius:50%;background:#173b39;color:white;border:1px solid #ded8cc;outline:4px solid #e3e9df;font-weight:500;margin-bottom:10px;}.ds-stages small{display:block;margin-top:3px;font-size:10px;color:#586e65;}.ds-stage-note{font-size:11px;color:#586e65;margin-top:18px;}"
    }
  ],
  "narrative": {
    "northStar": "延续啤酒服运营通知",
    "overview": "本文件记录正式万圣节模块的既有视觉实现：深绿标题、暖纸色内容、浅绿分组与克制橙色。它延续用户批准的紧凑运营通知方向，不定义其他看板或整个应用的样式。\n\n以清楚的日期、数字、当前负责人和建议动作为阅读主体。七阶段时间轴接在筛选之后，完整商品、排期和来源通过弹窗按需展开；保留生产应用的 Ant Design Modal 行为。视觉规则以同目录 `style.css` 和 `index.vue` 的有效样式为依据，原型中未被生产组件使用的原生 `dialog` 样式不是生产弹窗规范。",
    "keyCharacteristics": [
      "单一暖纸面板，深绿标题与细线分区。",
      "五项摘要、六项分组和八条主区待办保持紧凑密度。",
      "英文分类、当前归属与库存字段直接相邻。",
      "日历进度、销售进度和处理确认使用各自明确的文字。"
    ],
    "rules": [
      {
        "name": "The State Rule",
        "body": "颜色之外始终保留状态文字；日历经过、销售完成率与处理确认不能互相替代。",
        "section": "colors"
      }
    ],
    "dos": [
      "Do 保留批准的深绿、暖纸色、紧凑层级和顶部七阶段顺序。",
      "Do 把当前归属、数据范围、库存字段与动作条件放在对应信息附近。",
      "Do 用文字区分日历时间、销售进度和持久化确认。",
      "Do 保留键盘焦点、局部横向滚动和按需展开的完整来源。"
    ],
    "donts": [
      "Don't 把旧原型的刷新重置确认规则复制到生产模块。",
      "Don't 将确认状态说成真实调价、广告或消息已经执行。",
      "Don't 为简化摘要而把缺失值填零、混用目标范围或重复累加共享库存。",
      "Don't 将未被生产组件使用的原型样式宣称为正式弹窗规范。"
    ]
  }
}
